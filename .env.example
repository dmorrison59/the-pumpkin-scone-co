# Stripe TEST secret key while building. Replace with live key only when ready.
STRIPE_SECRET_KEY=sk_test_replace_me

# Public site origin. Use http://localhost:3000 locally and your final domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set Stripe Price IDs if you prefer managing prices/products in Stripe Dashboard.
# If left blank, the checkout route uses the built-in $19 / $36 price_data values.
STRIPE_PRICE_4_PACK=
STRIPE_PRICE_8_PACK=
